# PocketClot Server — Environment Variables
# Copy this file to .env and adjust the values.

# === Required ===

# Auth token shared between app and server. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# NOTE: the server REFUSES to start while this is left at the placeholder below
# (or other obvious values like "changeme"/"secret") — paste a real token here.
SERVER_TOKEN=change-me-to-a-long-random-string

# === Optional ===

# Override the specific model. Default = whatever Claude Code defaults to for
# your subscription (Sonnet on Pro, configurable on Max).
# Examples: "opus", "opus[1m]", "sonnet" (Kurznamen, die CLI nimmt die neueste Generation)
# CLAUDE_MODEL=

# Server binding. Default is loopback (127.0.0.1) — the Tailscale funnel proxies
# to localhost anyway, so that's enough. Only set 0.0.0.0 if you deliberately
# want the server reachable directly on your LAN/VPN.
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# CORS: comma-separated list of allowed origins. "*" = any website may call the
# API (convenient for local/tunnel use, but loose). For a tighter setup, set
# this to your app/web-UI origin(s), e.g. CORS_ORIGINS=https://pocket.example.de
CORS_ORIGINS=*

# Data directory (SQLite database + uploads)
DATA_DIR=./data

# Maximum upload size in MB
MAX_UPLOAD_MB=20

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Security: allow Claude to run Bash on the host? Off by default. With this
# off, the "Code execution" toggle in the app is a no-op and Bash is stripped
# from the tool list server-side. Only turn this on if you trust every user
# you've given an account to — Bash runs as the pocket-claude system user.
ALLOW_BASH=0

# Optional: bind this server to a Google Cloud billing account so the
# in-app TTS-spend widget can show your monthly credit + brutto-spend.
# Leave empty to hide the widget.
# POCKET_CLAUDE_BILLING_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Additional chat models (Gemini / GPT) via OpenAI-compatible gateways
# ---------------------------------------------------------------------------
# Claude stays the primary model and always works without any of this. If you
# also run OpenAI-compatible gateways in front of your own accounts (for
# example CLIProxyAPI for Google accounts, or codex-lb for ChatGPT accounts),
# list them here and their models show up in the app's model picker.
#
# Both endpoints only need to speak GET /v1/models and
# POST /v1/chat/completions with streaming. Discovery is automatic: log a new
# account into the gateway and the model appears in the app, no rebuild needed.
#
# Variant 1, any number of gateways, as a JSON list on one line:
# EXTRA_MODEL_GATEWAYS=[{"id":"pool","label":"Model pool","base_url":"http://127.0.0.1:8317/v1","api_key":"...","timeout":120}]
#
# Variant 2, the common case. Point both at the same URL if one gateway serves
# both families; the server then merges them into a single entry.
# GEMINI_GATEWAY_URL=http://127.0.0.1:8317/v1
# GEMINI_GATEWAY_KEY=
# GPT_GATEWAY_URL=http://127.0.0.1:2455/v1
# GPT_GATEWAY_KEY=
#
# Reasoning depth the additional models run at when the client sends none.
# EXTRA_MODEL_DEFAULT_EFFORT=high
#
# Which of the gateway models show up in the app's picker. Comma-separated glob
# patterns matched against the BASE id (no reasoning-depth suffix, no "gw:"
# prefix). Empty = show everything the gateways offer.
# Careful with broad patterns: "gpt-*" would also let through "gpt-oss-120b",
# which runs on a Google account and has nothing to do with a ChatGPT plan.
# MODEL_ALLOWLIST=gemini-flash,gpt-sol,gpt-luna
#
# ---------------------------------------------------------------------------
# Web access and image generation for the additional models
# ---------------------------------------------------------------------------
# Both are driven entirely by the gateways above, so there is nothing extra to
# configure and no separate API key to pay for:
#
#   - Web search: GPT models on codex-lb use the gateway's own built-in search.
#     Gemini models get Google grounding through the gateway's native Gemini
#     endpoint (/v1beta), because the OpenAI-compatible endpoint cannot do it.
#   - Page fetch: handled by the server itself, for every model.
#   - Images: generated by whichever image model the gateway reports (for
#     CLIProxyAPI that is a Gemini image model). The per-user Google API key
#     that older versions used for this is no longer needed.

# ---------------------------------------------------------------------------
# Read-aloud service (Gemini web session)
# ---------------------------------------------------------------------------
# Text-to-speech through the read-aloud call of gemini.google.com. A small
# service holds a signed-in Google session and returns Ogg/Opus. It is free,
# needs no API key, and is roughly 40x faster than real time.
#
# This is the DEFAULT provider when the service answers. If it does not run,
# nothing changes: the server falls back to Cloud TTS / Gemini API / Edge TTS
# exactly as before, and nobody is switched over.
#
# The service must be reachable from the server host. Default is loopback,
# which is the right answer when both run on the same machine.
# GEMINI_WEB_TTS_URL=http://127.0.0.1:8811
